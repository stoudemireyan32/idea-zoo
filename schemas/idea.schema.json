{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-zoo.dev/schema/idea.schema.json",
  "title": "Idea Zoo Idea Content Schema",
  "type": "object",
  "required": [
    "id",
    "slug",
    "category",
    "difficulty",
    "status",
    "compute",
    "source",
    "model",
    "dataset",
    "keywords",
    "upvotes",
    "downvotes",
    "trending",
    "created_at",
    "human_reviewed",
    "verification_verdict",
    "score_implementability",
    "score_operability",
    "score_innovation",
    "score_similarity_risk",
    "score_verification_confidence",
    "score_potential_impact"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^idea-[0-9]{3,}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "category": { "type": "string", "minLength": 2 },
    "difficulty": { "enum": ["Beginner", "Intermediate", "Advanced"] },
    "status": { "enum": ["Open", "Debate", "Claimed", "In Progress"] },
    "compute": { "enum": ["Low", "Medium", "High"] },
    "source": { "enum": ["AI-generated", "Community", "Hybrid"] },
    "model": { "type": "string", "minLength": 2 },
    "dataset": { "type": "string", "minLength": 2 },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "upvotes": { "type": "integer", "minimum": 0 },
    "downvotes": { "type": "integer", "minimum": 0 },
    "trending": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "human_reviewed": { "type": "boolean" },
    "discussion_number": { "type": ["integer", "null"], "minimum": 1 },
    "verification_verdict": { "enum": ["Strong", "Promising", "Speculative"] },
    "score_implementability": { "type": "integer", "minimum": 1, "maximum": 10 },
    "score_operability": { "type": "integer", "minimum": 1, "maximum": 10 },
    "score_innovation": { "type": "integer", "minimum": 1, "maximum": 10 },
    "score_similarity_risk": { "type": "integer", "minimum": 1, "maximum": 10 },
    "score_verification_confidence": { "type": "integer", "minimum": 1, "maximum": 10 },
    "score_potential_impact": { "type": "integer", "minimum": 1, "maximum": 10 }
  },
  "additionalProperties": true
}
