# Community provider mode: mock | github-api | proxy
VITE_COMMUNITY_PROVIDER=proxy

# For proxy mode (recommended)
VITE_COMMUNITY_PROXY_BASE_URL=/api/community

# For direct github-api mode (not recommended for production frontend)
# VITE_GITHUB_TOKEN=ghp_xxx

# Proxy server env (server-side, not VITE_)
# COMMUNITY_PROXY_PORT=8899
# GITHUB_OWNER=stoudemireyan32
# GITHUB_REPO=idea-zoo
# GITHUB_DISCUSSION_CATEGORY=ideas
# GITHUB_TOKEN=ghp_xxx
